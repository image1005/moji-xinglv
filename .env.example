# 百度地图服务端 AK（全景需申请 "for server" 类型）
BAIDU_MAP_AK=

# 城市交互地图专用的浏览器端 AK；允许下发浏览器，需配置 Referer 白名单。
# 与上面的服务端 AK 分开创建，开发时允许实际使用的 localhost/127.0.0.1 来源。
NUXT_PUBLIC_BAIDU_MAP_BROWSER_AK=

# Better Auth
AUTH_SECRET=please-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# SQLite 数据库文件路径
DATABASE_URL=file:./data/app.db

# 官方 DeepSeek：2026-09-18 已实际验证 flash 的视觉、工具与思考；旧 chat 别名规范为 flash
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
# 自定义兼容网关可显式配置 deepseek 使用官方 SDK；其它供应商留空，能力默认保守
AI_PROVIDER=
# 仅对已自行验证的兼容网关视觉模型启用，不能凭模型名称猜测支持
AI_SUPPORTS_VISION=false
# 仅对已核实支持 DeepSeek thinking/reasoning_effort 及 reasoning_content 工具续传的兼容接口填写。
# 配合 AI_PROVIDER=deepseek；按实际能力逐项列出 off,light,standard,deep（对应关闭/low/high/max）。
# 留空只允许关闭思考；选择 DeepSeek SDK 本身不代表兼容接口具备官方模型能力。
AI_DEEPSEEK_THINKING_LEVELS=
# auto 优先 Tavily，未配置时使用官方 DeepSeek Anthropic 搜索；也可指定 deepseek/tavily/off
AI_SEARCH_PROVIDER=auto
# 可选独立搜索服务；官方 DeepSeek 密钥可直接提供搜索，无需额外填写
TAVILY_API_KEY=

# 推荐图片独立于聊天联网开关；Wikidata、Wikimedia、Openverse 默认免密钥启用
# 默认 off 仅使用免费来源；auto / tencent 可显式启用腾讯云付费补充
MEDIA_IMAGE_SEARCH=off
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 使用临时凭据时填写 Token，长期密钥留空；需先开通联网图像搜索服务
TENCENTCLOUD_TOKEN=
# 单进程每小时付费搜索请求上限；重启清零，搜索命中缓存1天、空结果10分钟
MEDIA_IMAGE_SEARCH_HOURLY_LIMIT=60

# AI 输入包含系统规则、规划、历史和工具契约，单位为 UTF-8 字节
AI_INPUT_MAX_BYTES=96000
# 工具续传必须完整回传的模型思考另计（JSON UTF-8 字节，含元数据）；不挤占上方事实/工具预算。
# 超限明确失败，绝不删除/截断思考；默认256KiB，最高2MiB。
AI_REASONING_MAX_BYTES=262144
# 图片独立计算，不占上述文字JSON预算；历史与当前图片合计限制
AI_INPUT_MAX_IMAGE_BYTES=20971520
AI_INPUT_MAX_IMAGES=12
AI_OUTPUT_MAX_TOKENS=4096
# 开启思考时每个模型步骤的总输出额度（思考 + 正文 + 工具参数），不改变所选思考深度。
# DeepSeek 的 max_tokens 包含思考消耗；默认 32K，最高 128K，整轮期限仍独立生效。
AI_THINKING_OUTPUT_MAX_TOKENS=32768
# 整轮（含排队、思考、正文和工具）期限；超时明确失败，释放后可再次发送；范围 1秒–10分钟
AI_RUN_TIMEOUT_MS=180000
AI_GLOBAL_CONCURRENCY=4
AI_USER_CONCURRENCY=1
AI_QUEUE_LIMIT=8
AI_QUEUE_WAIT_MS=10000
AI_REQUESTS_PER_PERIOD=60
AI_GLOBAL_REQUESTS_PER_PERIOD=1000
AI_PERIOD_SECONDS=3600

# 后端图片/JSON缓存总容量（字节），定时分批回收过期与超额条目
CACHE_MAX_BYTES=536870912

# 一致性备份输出目录；备份始终创建新文件，不覆盖已有备份或源数据库
BACKUP_DIR=./backups

# 可选真实模型评测；默认关闭。EVAL_MAX_CASES限制外部调用样例数
EVAL_LIVE=false
EVAL_MAX_CASES=5

# 开发种子；生产环境必须显式提供安全密码，脚本不输出密码
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# 手动 HTTP 冒烟仅用于独立测试环境；推荐 bun run test:integration 自动隔离
SMOKE_BASE=http://127.0.0.1:3000
SMOKE_EMAIL=
SMOKE_PASSWORD=
SMOKE_ALLOW_REMOTE=false
SMOKE_TIMEOUT_MS=15000
