{
  "name": "shanhai-xingjian",
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun nuxt dev",
    "build": "bun --bun nuxt build",
    "preview": "bun --bun nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun run server/database/migrate.ts",
    "db:seed": "bun run server/database/seed.ts",
    "db:backup": "bun run scripts/db-backup.ts",
    "db:restore:verify": "bun run scripts/db-restore-verify.ts",
    "lint": "eslint .",
    "typecheck": "bun --bun nuxt typecheck && bun run typecheck:scripts",
    "typecheck:scripts": "bun --bun tsc --project tsconfig.scripts.json --noEmit",
    "test": "bun run scripts/test-unit.ts",
    "check:deadcode": "bun --bun nuxt prepare && bun --bun knip && bun --bun knip --production",
    "check": "bun run lint && bun run typecheck && bun run test && bun run check:deadcode",
    "check:release": "bun run check && bun run verify:media && bun run build && bun run test:integration && bun run test:recovery && bun run test:browser && bun run test:product",
    "smoke": "bun run scripts/smoke.ts",
    "test:integration": "bun run scripts/verify-isolated.ts",
    "test:browser": "bun run scripts/test-browser.ts",
    "test:recovery": "bun run scripts/test-recovery.ts",
    "test:product": "bun run scripts/test-product.ts",
    "eval:ai": "bun run scripts/eval-ai.ts",
    "verify:providers": "bun run scripts/verify-providers.ts",
    "verify:media": "bun run scripts/verify-media-providers.ts",
    "preview:readme": "bun run scripts/preview-readme.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "1.0.57",
    "@ai-sdk/provider": "2.0.4",
    "@ai-sdk/vue": "2.0.257",
    "@mastra/ai-sdk": "^1.10.2",
    "@mastra/core": "^1.66.0",
    "@nuxtjs/mdc": "^0.23.1",
    "ai": "5.0.257",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "h3": "1.15.11",
    "md-editor-v3": "^6.5.6",
    "nuxt": "^4.5.2",
    "sharp": "0.34.5",
    "vue": "3.5.42",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "github-markdown-css": "^5.9.0",
    "knip": "6.37.0",
    "marked": "^18.0.13",
    "marked-gfm-heading-id": "^4.1.4",
    "oxc-parser": "0.150.0",
    "sass": "^1.104.1",
    "typescript": "^5.9.0",
    "unimport": "6.5.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.11"
  }
}
